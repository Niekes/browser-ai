{
  "name": "browser-ai",
  "version": "0.0.0",
  "private": true,
  "description": "Local AI components for shadcn/ui: models that run in the browser. A shadcn registry.",
  "homepage": "https://niekes.github.io/browser-ai/",
  "bugs": {
    "url": "https://github.com/Niekes/browser-ai/issues"
  },
  "license": "BSD-3-Clause",
  "author": "Niekes (https://niekes.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Niekes/browser-ai.git"
  },
  "type": "module",
  "scripts": {
    "typecheck": "react-router typegen && tsc --noEmit",
    "build": "pnpm typecheck && pnpm registry:build && pnpm docs:build",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:e2e": "playwright test",
    "coverage": "vp test run --coverage",
    "coverage:badge": "node scripts/coverage-badge.mjs",
    "registry:build": "shadcn build",
    "docs:dev": "react-router dev",
    "docs:build": "react-router build && mv build/client/index.html build/client/404.html && cp -R build/client/browser-ai/. build/client && rm -rf build/client/browser-ai",
    "docs:preview": "vp preview --outDir build/client",
    "lint:template": "node scripts/check-template.mjs",
    "lint:fallow": "fallow dead-code --ci --format ${FALLOW_FORMAT:-human} && fallow health --ci --coverage-gaps --min-score 98 --format ${FALLOW_FORMAT:-human} && fallow dupes --ci --format ${FALLOW_FORMAT:-human}",
    "lint": "react-router typegen && vp fmt --check && vp lint && pnpm lint:template && pnpm lint:fallow",
    "verify": "pnpm lint && pnpm coverage",
    "hooks:install": "fallow hooks install --target git && fallow hooks install --target agent --agent claude && fallow hooks install --target agent --agent codex"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.78.0",
    "parakeet.js": "1.4.4",
    "radix-ui": "^1.8.1",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@react-router/dev": "^8.5.2",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "fallow": "^3.47.0",
    "fumadocs-core": "^16.19.7",
    "fumadocs-mdx": "^15.6.4",
    "fumadocs-typescript": "^5.6.2",
    "fumadocs-ui": "^16.19.7",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.18.0 || ^24.11.0 || >=26.0.0"
    }
  },
  "packageManager": "pnpm@12.23.0"
}
